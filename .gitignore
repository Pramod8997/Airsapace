# ==============================================================================
# AirStat India — .gitignore
# ==============================================================================

# Byte-compiled / Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / Packaging
build/
develop-eggs/
dist/
dist-ssr/
downloads/
eggs/
.eggs/
# lib/ and lib64/ are anchored to root — an unanchored "lib/" also matches frontend/src/lib/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.whl
share/python-wheels/
pip-wheel-metadata/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing, Coverage & Quality Tools
.pytest_cache/
.coverage
.coverage.*
coverage.xml
*.lcov
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Node / Frontend
node_modules/
*.local
.vite/
.eslintcache
.oxlintcache
.turbo/
*.tsbuildinfo

# Logs & Runtime Process Files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.seed

# Environment & Secrets (SECURITY.md: secrets must never enter source control)
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.cert
*.crt
*.token
*.secret
credentials.json
client_secret*.json
.secrets
.secrets.*

# Databases & Local Data Storage
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/*.db
data/*.db-*
data/*.sqlite*
data/raw/
# Replay dataset is deterministically regenerable (seeded generator) and the
# extended 12-month window would exceed GitHub's 100MB file limit.
data/fixtures/replay_quotes.jsonl

# Internal / Legacy Documentation
README_internal.md

# Agent & Knowledge Graph Artifacts (.claudeignore parity)
graphify-out/
graph.json
.gemini/
.claude/
.agents/
.cursor/
.windsurf/
.antigravity/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo
*.sw?
*.un~
*~
*.bak
*.tmp
*.temp
*.sublime-workspace
*.sublime-project
*.suo
*.ntvs*
*.njsproj
*.sln
.zed/
